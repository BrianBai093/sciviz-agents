# secrets
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# data and runtime output (large / generated)
data/
workspaces/
*.duckdb
*.duckdb.wal
!catalog/*.duckdb
.cdn_cache/
evals/results/raw/

# node
node_modules/
frontend/dist/

# os / editors
.DS_Store
.idea/
.vscode/

# run logs
logs/

# reproduction packages: keep their data/ (the rule above ignores every data/), but not the unpacked API
# responses or the replay output
!reproductions/*/data/
reproductions/*/data/api_responses.sqlite
reproductions/*/data/api_responses.sqlite-*
reproductions/*/replay/

# replay server artifacts
recordings/_ledger.*
demo/video/_raw/
demo/tts_cache/
