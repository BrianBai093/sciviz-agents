# Copy to .env and fill in. Never commit .env.

# Required for live runs (not needed for replay mode)
OPENAI_API_KEY=

# Only needed to re-download the OpenAlex snapshot (data_pipeline/fetch_openalex_snapshot.py)
OPENALEX_API_KEY=

# Optional overrides
# SCIVIZ_DB=data/columbia.duckdb           # processed DuckDB file
# SCIVIZ_MODEL=openai:gpt-6.2-sol          # default model for all agents
# SCIVIZ_ESCALATION_MODEL=openai:gpt-6.2-astra
# SCIVIZ_BUDGET_USD=50                     # hard cap on total LLM spend (ledger)
